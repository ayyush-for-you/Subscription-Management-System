{
  "name": "brightloop-subscription-management",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/api", "apps/web", "packages/shared"],
  "scripts": {
    "dev": "npm run dev --workspace apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test --workspace apps/api",
    "test:integration": "npm run test:integration --workspace apps/api",
    "test:story": "npm run test:story --workspace apps/api",
    "seed": "npm run seed --workspace apps/api",
    "seed:demo": "npm run seed:demo --workspace apps/api",
    "bench": "npm run bench --workspace apps/api",
    "legacy:dev": "next dev",
    "legacy:build": "next build",
    "legacy:start": "next start",
    "legacy:db:push": "prisma db push",
    "legacy:db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "bcryptjs": "^2.4.3",
    "next": "14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0",
    "lucide-react": "^0.323.0",
    "date-fns": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "prisma": "^5.9.1",
    "typescript": "^5.4.3"
  },
  "engines": { "node": ">=20" }
}
