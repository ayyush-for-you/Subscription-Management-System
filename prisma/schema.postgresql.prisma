datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum PlanFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  OVERDUE
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// 1. Users & Access Control
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(CUSTOMER)
  companyName   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  invoices      Invoice[]
  auditLogs     AuditLog[]
}

// 2. Product Catalog & Variants
model Product {
  id          String             @id @default(uuid())
  name        String
  type        String             @default("Software")
  salesPrice  Decimal            @db.Decimal(10, 2)
  costPrice   Decimal            @db.Decimal(10, 2)
  notes       String?
  variants    ProductVariant[]
  lines       SubscriptionLine[]
}

model ProductVariant {
  id              String             @id @default(uuid())
  productId       String
  product         Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantName     String             // e.g. "Odoo Brand"
  priceAdjustment Decimal            @default(0.00) @db.Decimal(10, 2) // e.g. +560.00
  lines           SubscriptionLine[]
}

// 3. Plans
model Plan {
  id            String             @id @default(uuid())
  name          String
  basePrice     Decimal            @db.Decimal(10, 2)
  frequency     PlanFrequency      @default(MONTHLY)
  minQuantity   Int                @default(1)
  availableFrom DateTime?
  availableTo   DateTime?
  autoClose     Boolean            @default(false)
  canPause      Boolean            @default(true)
  subscriptions Subscription[]
}

// 4. Subscriptions & Quotations
model Subscription {
  id                 String             @id @default(uuid())
  subscriptionNumber String             @unique // e.g. SUB-2026-0001
  customerId         String
  customer           User               @relation(fields: [customerId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(DRAFT)
  startDate          DateTime           @default(now())
  expiryDate         DateTime?
  nextBillingDate    DateTime?
  paymentTerms       String             @default("Net 15")
  discountId         String?
  discount           Discount?          @relation(fields: [discountId], references: [id])
  shareToken         String?            @unique
  lines              SubscriptionLine[]
  invoices           Invoice[]
  auditLogs          AuditLog[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionLine {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(10, 2)
  taxRate        Decimal         @default(0.00) @db.Decimal(5, 2)
  subtotal       Decimal         @db.Decimal(10, 2)
}

// 5. Invoicing & Billing Engine
model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique // e.g. INV-2026-0001
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  customerId     String
  customer       User          @relation(fields: [customerId], references: [id])
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0.00) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  balanceDue     Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(DRAFT)
  dunningStage   Int           @default(0)
  payments       Payment[]
  auditLogs      AuditLog[]
  createdAt      DateTime      @default(now())

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

// 6. Payments
model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String
  paymentDate   DateTime @default(now())
  referenceNote String?
}

// 7. Discounts & Taxes
model Discount {
  id                String         @id @default(uuid())
  code              String         @unique
  discountType      DiscountType   @default(PERCENTAGE)
  value             Decimal        @db.Decimal(10, 2)
  minPurchaseAmount Decimal?       @db.Decimal(10, 2)
  minQuantity       Int?
  validFrom         DateTime?
  validTo           DateTime?
  maxUses           Int?
  currentUses       Int            @default(0)
  subscriptions     Subscription[]
}

// 8. ERP Audit Log / Activity Chatter
model AuditLog {
  id             String        @id @default(uuid())
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id])
  action         String
  details        String
  createdAt      DateTime      @default(now())

  @@index([subscriptionId])
  @@index([invoiceId])
}

