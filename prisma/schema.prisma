datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Users & Access Control
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          String         @default("CUSTOMER") // ADMIN, STAFF, CUSTOMER
  companyName   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  invoices      Invoice[]
  auditLogs     AuditLog[]
}

// 2. Product Catalog & Variants
model Product {
  id          String             @id @default(uuid())
  name        String
  type        String             @default("Software") // Software, Service, Add-on
  salesPrice  Float
  costPrice   Float
  notes       String?
  variants    ProductVariant[]
  lines       SubscriptionLine[]
}

model ProductVariant {
  id              String             @id @default(uuid())
  productId       String
  product         Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantName     String             // e.g. "Odoo Brand", "Enterprise Tier", "High Memory"
  priceAdjustment Float              @default(0.0) // e.g. +560.00
  lines           SubscriptionLine[]
}

// 3. Plans
model Plan {
  id            String             @id @default(uuid())
  name          String
  basePrice     Float
  frequency     String             @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, YEARLY
  minQuantity   Int                @default(1)
  availableFrom DateTime?
  availableTo   DateTime?
  autoClose     Boolean            @default(false)
  canPause      Boolean            @default(true)
  subscriptions Subscription[]
}

// 4. Subscriptions & Quotations
model Subscription {
  id                 String             @id @default(uuid())
  subscriptionNumber String             @unique // e.g. SUB-2026-0001
  customerId         String
  customer           User               @relation(fields: [customerId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             String             @default("DRAFT") // DRAFT, QUOTATION, CONFIRMED, ACTIVE, PAUSED, CLOSED
  startDate          DateTime           @default(now())
  expiryDate         DateTime?
  nextBillingDate    DateTime?
  paymentTerms       String             @default("Net 15")
  discountId         String?
  discount           Discount?          @relation(fields: [discountId], references: [id])
  shareToken         String?            @unique
  lines              SubscriptionLine[]
  invoices           Invoice[]
  auditLogs          AuditLog[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionLine {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  quantity       Int             @default(1)
  unitPrice      Float
  taxRate        Float           @default(0.0)
  subtotal       Float
}

// 5. Invoicing & Billing Engine
model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique // e.g. INV-2026-0001
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  customerId     String
  customer       User          @relation(fields: [customerId], references: [id])
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Float
  taxAmount      Float         @default(0.0)
  discountAmount Float         @default(0.0)
  totalAmount    Float
  balanceDue     Float
  status         String        @default("DRAFT") // DRAFT, CONFIRMED, PAID, OVERDUE, CANCELLED
  dunningStage   Int           @default(0) // 0: None, 1: Day 3 Reminder, 2: Day 7 Urgent, 3: Day 14 Paused
  payments       Payment[]
  auditLogs      AuditLog[]
  createdAt      DateTime      @default(now())

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

// 6. Payments
model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Float
  paymentMethod String   // "Credit Card", "Bank Transfer", "Stripe", "Cash", "Check"
  paymentDate   DateTime @default(now())
  referenceNote String?
}

// 7. Discounts & Taxes
model Discount {
  id                String         @id @default(uuid())
  code              String         @unique
  discountType      String         @default("PERCENTAGE") // PERCENTAGE, FIXED
  value             Float
  minPurchaseAmount Float?
  minQuantity       Int?
  validFrom         DateTime?
  validTo           DateTime?
  maxUses           Int?
  currentUses       Int            @default(0)
  subscriptions     Subscription[]
}

model TaxRule {
  id        String   @id @default(uuid())
  name      String   // e.g. "VAT 20%", "Sales Tax 10%", "GST 18%"
  rate      Float    // e.g. 20.0, 10.0, 18.0
  region    String?  // e.g. "US", "EU", "APAC"
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// 8. ERP Audit Log / Activity Chatter
model AuditLog {
  id             String        @id @default(uuid())
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id])
  action         String        // "STATE_CHANGE", "DISCOUNT_APPLIED", "INVOICE_GENERATED", "PAYMENT_RECEIVED", "DUNNING_TRIGGERED", "NOTE_ADDED"
  details        String
  createdAt      DateTime      @default(now())

  @@index([subscriptionId])
  @@index([invoiceId])
}

